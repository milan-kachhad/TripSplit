{
  "name": "tripsplit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,client\" -c \"yellow.bold,cyan.bold\" \"nodemon server/server.js\" \"vite\"",
    "server": "nodemon server/server.js",
    "server:prod": "node server/server.js",
    "db:setup": "node server/scripts/run_sql.js",
    "client": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "mysql2": "^3.24.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "nodemon": "^3.1.14",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
